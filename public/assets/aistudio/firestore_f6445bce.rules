rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Helpers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'arnav.0251mba158@dgu.ac.in'
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role is string
        && data.role == 'member'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavorite(data, userId, stayId) {
      return data.keys().hasAll(['userId', 'stayId', 'stayName', 'createdAt'])
        && data.keys().hasOnly(['userId', 'stayId', 'stayName', 'createdAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.stayId is string
        && data.stayId.size() >= 1
        && data.stayId.size() <= 64
        && data.stayId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.stayId == stayId
        && data.stayName is string
        && data.stayName.size() >= 1
        && data.stayName.size() <= 140
        && data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'userId',
          'stayId',
          'stayName',
          'stayLocation',
          'nights',
          'guests',
          'totalAmount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'stayId',
          'stayName',
          'stayLocation',
          'nights',
          'guests',
          'totalAmount',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.stayId is string
        && data.stayId.size() >= 1
        && data.stayId.size() <= 64
        && data.stayId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.stayName is string
        && data.stayName.size() >= 1
        && data.stayName.size() <= 140
        && data.stayLocation is string
        && data.stayLocation.size() >= 1
        && data.stayLocation.size() <= 140
        && data.nights is int
        && data.nights >= 1
        && data.nights <= 14
        && data.guests is int
        && data.guests >= 1
        && data.guests <= 8
        && (data.totalAmount is int || data.totalAmount is float)
        && data.totalAmount > 0
        && data.totalAmount <= 2000000
        && data.status is string
        && data.status in ['confirmed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStayReview(data) {
      return data.keys().hasAll([
          'stayId',
          'authorUid',
          'guestName',
          'guestInitials',
          'guestRole',
          'guestCity',
          'stayDate',
          'nightsStayed',
          'rating',
          'highlight',
          'quote',
          'isPublished',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'stayId',
          'authorUid',
          'guestName',
          'guestInitials',
          'guestRole',
          'guestCity',
          'stayDate',
          'nightsStayed',
          'rating',
          'highlight',
          'quote',
          'isPublished',
          'createdAt',
          'updatedAt'
        ])
        && data.stayId is string
        && data.stayId.size() >= 1
        && data.stayId.size() <= 64
        && data.stayId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorUid is string
        && isValidId(data.authorUid)
        && data.guestName is string
        && data.guestName.size() >= 2
        && data.guestName.size() <= 80
        && data.guestInitials is string
        && data.guestInitials.size() >= 1
        && data.guestInitials.size() <= 4
        && data.guestRole is string
        && data.guestRole.size() >= 2
        && data.guestRole.size() <= 80
        && data.guestCity is string
        && data.guestCity.size() >= 2
        && data.guestCity.size() <= 80
        && data.stayDate is string
        && data.stayDate.size() >= 4
        && data.stayDate.size() <= 40
        && data.nightsStayed is int
        && data.nightsStayed >= 1
        && data.nightsStayed <= 30
        && (data.rating is int || data.rating is float)
        && data.rating >= 1
        && data.rating <= 5
        && data.highlight is string
        && data.highlight.size() >= 3
        && data.highlight.size() <= 120
        && data.quote is string
        && data.quote.size() >= 12
        && data.quote.size() <= 1000
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Admins lookup collection (read-only from client)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Member profiles (PII-isolated: owner or admin get only; no public list)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (
          (
            isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().email == request.auth.token.email
            && incoming().role == existing().role
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
          ) || isAdmin()
        );
      allow delete: if false;

      // Saved sanctuary bookmarks (Master Gate on parent /users/{userId})
      match /favorites/{stayId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(stayId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(stayId)
          && isOwner(userId)
          && isValidFavorite(incoming(), userId, stayId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(stayId)
          && (isOwner(userId) || isAdmin());
      }
    }

    // Sanctuary bookings (owner-scoped reads & list queries, terminal cancellation lock)
    match /bookings/{bookingId} {
      allow get: if isSignedIn()
        && isValidId(bookingId)
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBooking(incoming())
        && (
          (
            existing().userId == request.auth.uid
            && existing().status == 'confirmed'
            && incoming().status == 'cancelled'
            && incoming().userId == existing().userId
            && incoming().stayId == existing().stayId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || isAdmin()
        );
      allow delete: if false;
    }

    // Verified stay reviews (no PII; readable by signed-in members when published or authored by self)
    match /stayReviews/{reviewId} {
      allow get: if isSignedIn()
        && isValidId(reviewId)
        && (existing().isPublished == true || existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.isPublished == true || resource.data.authorUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidStayReview(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().isPublished == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidStayReview(incoming())
        && (
          (
            existing().authorUid == request.auth.uid
            && incoming().authorUid == existing().authorUid
            && incoming().stayId == existing().stayId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'highlight', 'quote', 'updatedAt'])
          ) || isAdmin()
        );
      allow delete: if isVerifiedUser()
        && isValidId(reviewId)
        && (existing().authorUid == request.auth.uid || isAdmin());
    }
  }
}
